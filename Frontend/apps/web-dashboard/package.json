{
  "name": "@lcc/web-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "OKESON-LCC Next.js Web Dashboard + Mobile PWA.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --dir tests/unit",
    "test:component": "vitest run --dir tests/component",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bundle-size": "bash ../../tools/scripts/bundle-size-check.sh",
    "clean": "rm -rf .next .turbo coverage playwright-report test-results"
  },
  "dependencies": {
    "@lcc/api-types": "workspace:*",
    "@lcc/approval-gate": "workspace:*",
    "@lcc/compliance-state": "workspace:*",
    "@lcc/i18n": "workspace:*",
    "@lcc/realtime": "workspace:*",
    "@lcc/tokens": "workspace:*",
    "@lcc/ui": "workspace:*",
    "@lcc/test-utils": "workspace:*",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-query-devtools": "^5.40.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.7",
    "next-themes": "^0.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "sonner": "^1.4.41",
    "uuid": "^9.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
