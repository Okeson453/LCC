{
  "name": "lcc",
  "version": "1.0.0",
  "private": true,
  "description": "LinkedIn Manager (OKESON-LCC) — frontend monorepo. Web Dashboard, Mobile PWA, and Manifest V3 Browser Extension surfaces.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:component": "turbo run test:component",
    "test:e2e": "turbo run test:e2e",
    "test:visual": "turbo run test:visual",
    "typecheck": "turbo run typecheck",
    "codegen": "bash tools/scripts/codegen-api-types.sh",
    "bundle:check": "bash tools/scripts/bundle-size-check.sh",
    "lighthouse:ci": "bash tools/scripts/lighthouse-ci.sh",
    "boundaries:check": "bash tools/scripts/check_boundaries_frontend.sh",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.0",
  "enginesStrict": true
}
