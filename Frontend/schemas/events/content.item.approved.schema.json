{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://okeson.example/schemas/events/content.item.approved.schema.json",
  "title": "ContentItemApproved",
  "description": "Emitted when a content item's approval transitions to approved.",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "member_id", "content_item_id", "approval_id", "trace_id"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "content.item.approved" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "format": "uuid" },
    "member_id": { "type": "string", "format": "uuid" },
    "content_item_id": { "type": "string", "format": "uuid" },
    "approval_id": { "type": "string", "format": "uuid" }
  }
}
