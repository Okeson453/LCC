{
  "name": "@lcc/approval-gate",
  "version": "1.0.0",
  "private": true,
  "description": "Universal ApprovalDialog + supporting components. The single most important UX rule in OKESON-LCC: every external action requires explicit human approval via this dialog.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./context/*": "./src/context/*",
    "./utils/*": "./src/utils/*"
  },
  "files": ["src"],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@lcc/api-types": "workspace:*",
    "@lcc/tokens": "workspace:*",
    "@lcc/ui": "workspace:*",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-focus-scope": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
