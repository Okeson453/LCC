{
  "name": "@lcc/compliance-state",
  "version": "1.0.0",
  "private": true,
  "description": "Restricted-state hooks + banner + ComplianceGate. Mounted globally on every surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./context/*": "./src/context/*",
    "./utils/*": "./src/utils/*"
  },
  "files": ["src"],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@lcc/api-types": "workspace:*",
    "@lcc/tokens": "workspace:*",
    "@lcc/ui": "workspace:*",
    "@lcc/realtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
