{
  "name": "@lcc/i18n",
  "version": "1.0.0",
  "private": true,
  "description": "i18n setup for OKESON-LCC. English is the launch locale; structure is in place for future translations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./provider": "./src/provider.tsx",
    "./use-translation": "./src/use-translation.ts"
  },
  "files": ["src"],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "next-intl": "^3.13.0"
  }
}
