{
  "name": "@lcc/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension for LinkedIn Manager — Tier 1 actions only.",
  "type": "module",
  "main": "src/background/index.ts",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --dir test/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:component": "vitest run --dir test/component",
    "test:visual": "playwright test --project=visual",
    "bundle:analyze": "vite-bundle-analyzer",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@lcc/api-types": "workspace:*",
    "@lcc/approval-gate": "workspace:*",
    "@lcc/compliance-state": "workspace:*",
    "@lcc/i18n": "workspace:*",
    "@lcc/realtime": "workspace:*",
    "@lcc/tokens": "workspace:*",
    "@lcc/ui": "workspace:*",
    "@lcc/test-utils": "workspace:*",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@axe-core/playwright": "^4.9.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "happy-dom": "^14.0.0",
    "postcss": "^8.4.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-bundle-analyzer": "^0.4.0",
    "vitest": "^1.6.0"
  },
  "manifest": "public/manifest.json"
}
