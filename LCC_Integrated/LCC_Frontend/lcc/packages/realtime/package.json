{
  "name": "@lcc/realtime",
  "version": "1.0.0",
  "private": true,
  "description": "Shared WebSocket + SSE + polling client for OKESON-LCC. Encapsulates reconnection, channel subscriptions, and fall-through.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./channels/*": "./src/channels/*",
    "./hooks/*": "./src/hooks/*",
    "./utils/*": "./src/utils/*"
  },
  "files": ["src"],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@lcc/api-types": "workspace:*",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  }
}
